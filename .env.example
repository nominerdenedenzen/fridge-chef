# Copy this file to .env.local and fill in your keys. Never commit .env.local.

# --- Your site address (http://localhost:3000 while developing, your Vercel URL later)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (clerk.com -> your app -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YWJvdmUtZG9nLTQwLmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_iicxU0w1HpUp9HEz9n9IJp9RCp7rb0yOBSMzeLXZVx

# --- Supabase (Project settings -> API, and Connect -> ORMs -> Drizzle, use the pooler URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_BUCKET=fridge-photos

# --- Hugging Face (huggingface.co/settings/tokens, token needs "Inference Providers" permission)
HF_TOKEN=hf_xxx
# Vision model that reads the photo. Must show "Inference Providers" on its model page.
HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Chat model that writes a recipe when nothing online matches.
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
# Text embedding model (384 numbers) - must match the Pinecone index dimension.
HF_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Pinecone (index "recipes", dimension 384, metric cosine)
PINECONE_API_KEY=xxx
PINECONE_INDEX=recipes

# --- Recipe and nutrition APIs
MEALDB_KEY=1
SPOONACULAR_API_KEY=
USDA_API_KEY=DEMO_KEY

# --- Limits
FREE_SCANS_PER_DAY=5

# --- n8n (any long random string; n8n sends it in the x-n8n-secret header)
N8N_SECRET=change-me-to-a-long-random-string

# --- Facebook Graph API (only needed if the app posts by itself; n8n can post instead)
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v26.0

# --- Wire.mn payments
# WIRE_MODE=mock lets you test the whole Pro flow without Wire.mn. Use "live" when your account is ready.
WIRE_MODE=mock
WIRE_API_URL=https://api.wire.mn
WIRE_API_KEY=
WIRE_WEBHOOK_SECRET=
PRO_PRICE_MNT=9900
PRO_DAYS=30
